AWS_REGION=us-east-1

# The S3 bucket created and uploaded the CSVs to
S3_BUCKET_NAME=

# The "folder" (key prefix) inside the bucket where the raw CSVs live, e.g. data/raw/
S3_RAW_PREFIX=data/raw/

# Optional: prefix applied to every DynamoDB table name (see scripts/config.py)
DYNAMODB_TABLE_PREFIX=careerguardian_

BEDROCK_REGION=us-east-1
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0
